#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: dotfiles-stow [--platform PLATFORM] [--dry-run] [--restow]

Deploy this checkout's Stow packages to $HOME.

Platforms: auto (default), macos, linux, wsl
EOF
}

platform=auto
dry_run=0
restow=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --platform)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      platform=$2
      shift 2
      ;;
    --dry-run) dry_run=1; shift ;;
    --restow) restow=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd -P)

if [ "$platform" = auto ]; then
  case "$(uname -s)" in
    Darwin) platform=macos ;;
    Linux)
      if grep -qi microsoft /proc/version 2>/dev/null; then
        platform=wsl
      else
        platform=linux
      fi
      ;;
    *) printf 'Unsupported host: %s\n' "$(uname -s)" >&2; exit 1 ;;
  esac
fi

case "$platform" in macos|linux|wsl) ;; *) printf 'Unsupported platform: %s\n' "$platform" >&2; exit 2 ;; esac

command -v stow >/dev/null 2>&1 || {
  printf '%s\n' 'GNU Stow is required; run bootstrap or install it with the host package manager.' >&2
  exit 1
}

packages=common
[ -d "$repo_dir/$platform" ] && packages="$packages $platform"

set -- --dir "$repo_dir" --target "$HOME"
[ "$dry_run" -eq 1 ] && set -- "$@" --simulate
[ "$restow" -eq 1 ] && set -- "$@" --restow

printf 'Stow platform: %s; packages:%s\n' "$platform" "$packages"
# Intentional word splitting: package names are generated above and contain no spaces.
# shellcheck disable=SC2086
stow "$@" $packages
