#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: sync-dotfiles

Fast-forward this checkout to origin/main, update pinned submodules, and
restow. Refuses to run if the worktree has uncommitted changes.

Afterward, syncs (commit, pull, push) any optional companion repo listed in
repos.conf that is already cloned at its target dir. It does not clone
missing ones; that's bootstrap's job.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  '') ;;
  *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)

if ! git -C "$REPO_DIR" diff --quiet || ! git -C "$REPO_DIR" diff --cached --quiet; then
  printf '%s\n' 'Refusing to sync: the dotfiles worktree has changes. Commit, stash, or discard them explicitly first.' >&2
  exit 1
fi

git -C "$REPO_DIR" pull --ff-only origin main
git -C "$REPO_DIR" submodule update --init --recursive
"$SCRIPT_DIR/dotfiles-stow" --restow

if [ -f "$REPO_DIR/repos.conf" ]; then
  # shellcheck disable=SC1090
  . "$REPO_DIR/repos.conf"
  printf '%s\n' "${DOTFILES_OPTIONAL_REPOS:-}" | while IFS=: read -r name target; do
    [ -n "$name" ] || continue
    dest="$HOME/$target"
    [ -d "$dest/.git" ] || continue
    "$SCRIPT_DIR/.sync-repo" "$dest"
  done
fi
