#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: sync-notes [--dry-run|--check]

Commit any pending changes in the notes repo, pull, and push.

The repo defaults to $HOME/notes; override with the NOTES_DIR environment
variable. --dry-run prints the pending changes without committing, pulling,
or pushing. --check reports local drift without touching the network;
silent if clean.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
NOTES_DIR=${NOTES_DIR:-"$HOME/notes"}

exec "$script_dir/.sync-repo" "$NOTES_DIR" "$@"
