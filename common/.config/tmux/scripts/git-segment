#!/bin/sh
# Record a pane directory's git state for the tmux status bar in two pane
# options: @git_branch (branch, plus ↑/↓ commit counts against upstream) and
# @git_state (clean, dirty or conflict), which status-right turns into the
# git pill's colour. Both are empty outside a repository. Prints nothing, so
# it serves as a status-line #() job as well as zsh's precmd hook.
# --no-optional-locks keeps the read-only `git status` off the index lock.
pane=$1
dir=${2:-$PWD}
info=$(git -C "$dir" --no-optional-locks status --porcelain=v2 --branch 2>/dev/null | awk '
  /^# branch.oid / { oid = substr($3, 1, 7) }
  /^# branch.head / { head = $3 }
  /^# branch.ab / { ahead = substr($3, 2) + 0; behind = substr($4, 2) + 0 }
  /^u / { conflict = 1 }
  /^[^#]/ { dirty = 1 }
  END {
    if (head == "") exit
    if (head == "(detached)") head = oid
    if (ahead) head = head " ↑" ahead
    if (behind) head = head " ↓" behind
    printf "%s\t%s", conflict ? "conflict" : dirty ? "dirty" : "clean", head
  }')
tab=$(printf '\t')
state=${info%%"$tab"*}
branch=${info#*"$tab"}
tmux set-option -p -t "$pane" @git_state "$state" \; set-option -p -t "$pane" @git_branch "$branch"
